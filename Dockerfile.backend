# Stage 1: Build dependencies using Wolfi base
FROM cgr.dev/chainguard/wolfi-base:latest AS builder

RUN apk update && apk add python-3.12 py3.12-pip

WORKDIR /app

COPY requirements.txt ./
RUN python3.12 -m venv /app/venv
ENV PATH="/app/venv/bin:$PATH"
RUN pip install --no-cache-dir -r requirements.txt

# Stage 2: Distroless secure runtime
FROM cgr.dev/chainguard/wolfi-base:latest

RUN apk update && apk add python-3.12 && rm -rf /var/cache/apk/*

WORKDIR /app

# Copy virtual environment and source code
COPY --from=builder /app/venv /app/venv
COPY src/ ./src/

EXPOSE 8000
ENV PYTHONPATH=/app
ENV PATH="/app/venv/bin:$PATH"

# Run as non-root user (65532 is standard nonroot in Wolfi)
USER 65532

HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
  CMD ["/app/venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"]

ENTRYPOINT ["/app/venv/bin/python"]
CMD ["src/main.py"]
